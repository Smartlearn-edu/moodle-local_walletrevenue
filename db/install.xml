<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/walletrevenue/db" VERSION="20261010" COMMENT="XMLDB file for local_walletrevenue"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_walletrevenue_payee" COMMENT="Maps courses to payee teachers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Teacher user ID"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid_uniq" TYPE="unique" FIELDS="courseid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="teacherid_idx" UNIQUE="false" FIELDS="teacherid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_walletrevenue_rate" COMMENT="Commission rate overrides for teachers or courses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="teacher or course"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="userid or courseid"/>
        <FIELD NAME="percent" TYPE="number" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2" COMMENT="Commission percent"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="scope_item_uniq" TYPE="unique" FIELDS="scope, itemid"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_walletrevenue_sale" COMMENT="Saved sales and refund transactions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="transactionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="enrol_wallet_transactions ID or payments ID"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="wallet" SEQUENCE="false" COMMENT="wallet or core_payment"/>
        <FIELD NAME="gateway" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="wallet" SEQUENCE="false" COMMENT="Payment gateway or wallet"/>
        <FIELD NAME="type" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="sale or refund"/>
        <FIELD NAME="sourceop" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="enrol_instance, enrol, cm, section, unenrol, rollback, enrol_fee"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="studentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="saleid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Original sale ID if refund"/>
        <FIELD NAME="listprice" TYPE="number" LENGTH="14" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="14" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="percent" TYPE="number" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="teachershare" TYPE="number" LENGTH="14" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="USD" SEQUENCE="false"/>
        <FIELD NAME="freecut" TYPE="number" LENGTH="14" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="4" COMMENT="Free credits used"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timesynced" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="source_tx_uniq" TYPE="unique" FIELDS="source, transactionid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="teacherid_idx" UNIQUE="false" FIELDS="teacherid"/>
        <INDEX NAME="studentid_idx" UNIQUE="false" FIELDS="studentid"/>
        <INDEX NAME="source_idx" UNIQUE="false" FIELDS="source"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_walletrevenue_payout" COMMENT="Recorded payouts to teachers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="14" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="USD" SEQUENCE="false"/>
        <FIELD NAME="method" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reference" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="notes" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="recipienttype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="teacher" SEQUENCE="false" COMMENT="teacher or partner"/>
        <FIELD NAME="partnerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Partner ID if recipient is partner"/>
        <FIELD NAME="paidat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="teacherid_idx" UNIQUE="false" FIELDS="teacherid"/>
        <INDEX NAME="partnerid_idx" UNIQUE="false" FIELDS="partnerid"/>
        <INDEX NAME="paidat_idx" UNIQUE="false" FIELDS="paidat"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_walletrevenue_partner" COMMENT="Partner organizations/centers managing groups of teachers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Organization name"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID of the partner"/>
        <FIELD NAME="code" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Optional unique slug/code"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_uniq" TYPE="unique" FIELDS="userid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code_idx" UNIQUE="false" FIELDS="code"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_walletrevenue_partner_teacher" COMMENT="Mapping of teachers to partners">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="partnerid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Partner ID"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Teacher user ID"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="teacherid_uniq" TYPE="unique" FIELDS="teacherid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="partnerid_idx" UNIQUE="false" FIELDS="partnerid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
